# Supabase (required)
SUPABASE_URL=https://<project-ref>.supabase.co
# server-side only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
# browser / RLS-scoped client
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe (required only for paid forms)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Billplz (required only for MYR paid forms)
BILLPLZ_API_KEY=
BILLPLZ_X_SIGNATURE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Transactional email (respondent confirmation emails)
# https://resend.com — without a key, confirmation emails are skipped
RESEND_API_KEY=
EMAIL_FROM=MineForm <onboarding@resend.dev>
