# ---- Supabase (required) ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Email via Resend (optional; free tier works) --------------------------
# Without these, confirmation/owner emails and verification links are skipped
# and the app keeps working (unique-email forms auto-approve verification).
RESEND_API_KEY=
EMAIL_FROM="MineForm <forms@yourdomain.com>"

# ---- Cron (optional) -------------------------------------------------------
# Protects GET /api/cron/weekly-report; set the same value in Vercel.
CRON_SECRET=

# ---- App URL (optional) ----------------------------------------------------
# Absolute base URL used in emails/verification links. Falls back to the
# request origin.
NEXT_PUBLIC_APP_URL=

# ---- Waiting Room (optional) ------------------------------------------------
# In-memory waiting room to handle Supabase connection limits.
# When a form reaches its response_cap, users enter a FIFO queue and are
# admitted automatically when a spot opens up. No external services.
#
# GLOBAL_WAITING_ROOM_ENABLED=true          # Enable waiting room globally
# GLOBAL_WAITING_ROOM_MAX_ACTIVE=50         # Max concurrent active users (matches Supabase limit)
# GLOBAL_WAITING_ROOM_WAIT_TIMEOUT_MS=600000   # 10 minutes max wait time
# GLOBAL_WAITING_ROOM_ACTIVE_TTL_MS=1800000   # 30 minutes before inactive user is cleaned up
#
# Per-form waiting rooms can also be configured in the form's access_config:
# {"waitingRoom": {"enabled": true, "maxActive": 50, "waitTimeoutMs": 600000}}

# ---- Payments (optional, existing feature) ---------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLPLZ_SECRET_KEY=
