# ---- Supabase (required) ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Email via Resend (optional; free tier works) --------------------------
# Without these, confirmation/owner emails and verification links are skipped
# and the app keeps working (unique-email forms auto-approve verification).
RESEND_API_KEY=
EMAIL_FROM="MineForm <forms@yourdomain.com>"

# ---- Cron (optional) -------------------------------------------------------
# Protects GET /api/cron/weekly-report; set the same value in Vercel.
CRON_SECRET=

# ---- App URL (optional) ----------------------------------------------------
# Absolute base URL used in emails/verification links. Falls back to the
# request origin.
NEXT_PUBLIC_APP_URL=

# ---- Payments (optional, existing feature) ---------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLPLZ_SECRET_KEY=
